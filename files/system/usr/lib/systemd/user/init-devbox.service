[Unit]
Description=Initialize Development Distrobox Container
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/distrobox-create --name devbox --image registry.fedoraproject.org/fedora-toolbox:latest --yes --additional-packages "code git fish curl"
ExecStartPost=/usr/bin/distrobox-enter -n devbox -- distrobox-export --app code
RemainAfterExit=yes

[Install]
WantedBy=default.target
